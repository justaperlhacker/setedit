# ─────────────────────────────────────────────────────────────────────
# SETEdit revival — files produced by building; never commit these.
# (Several tracked Makefiles/headers in the tree are real sources —
#  .gitignore never affects already-tracked files, only new ones.)
# ─────────────────────────────────────────────────────────────────────

# Compiled objects and static libraries
*.o
*.a

# Shared objects: holiday plug-ins and (when enabled) drivers
*.so
*.so.*

# Executables and editor/RHIDE desktop state files
*.exe
*.gdt

# Generated by ./configure (the Perl config.pl, not autotools):
# top-level and sub-project makefiles, the cache and the config header
configure.cache
Makefile
rhide.env
configed.h

# Generated message catalogues (gettext)
*.mo

# Distribution / install staging trees
setedit-*
infview-*
result
resultInf
